  "diagnosis_questions": {
    "description": "テイスト診断用の質問。各質問は5軸のうち1-2軸に影響するスコアを持つ",
    "questions": [
      {
        "id": 1,
        "text": "服を選ぶとき、一番気にするのは？",
        "options": [
          { "text": "シルエットの美しさ・ラインの綺麗さ", "scores": { "decoration": -15, "structure": 15, "avantgarde": 10 } },
          { "text": "着心地のよさ・楽さ", "scores": { "formality": -15, "structure": -15, "playfulness": 5 } },
          { "text": "人と被らないデザイン性", "scores": { "avantgarde": 20, "decoration": 10 } },
          { "text": "清潔感・きちんと見えること", "scores": { "formality": 15, "structure": 10, "playfulness": -10 } }
        ]
      },
      {
        "id": 2,
        "text": "好きな色の組み合わせは？",
        "options": [
          { "text": "黒・白・グレーのモノトーン", "scores": { "decoration": -10, "playfulness": -15, "avantgarde": 5 } },
          { "text": "ネイビー・ベージュ・ブラウンの落ち着いたトーン", "scores": { "avantgarde": -10, "playfulness": -10, "formality": 5 } },
          { "text": "季節感のある差し色を入れるのが好き", "scores": { "playfulness": 10, "decoration": 10 } },
          { "text": "ビビッドな色やコントラスト強めが好き", "scores": { "playfulness": 20, "decoration": 15, "avantgarde": 5 } }
        ]
      },
      {
        "id": 3,
        "text": "理想の休日コーデは？",
        "options": [
          { "text": "上質なニット＋スラックスでカフェへ", "scores": { "formality": 10, "playfulness": -15, "structure": 10 } },
          { "text": "オーバーサイズT＋ワイドパンツでゆるく", "scores": { "structure": -15, "formality": -10, "playfulness": 5 } },
          { "text": "ジャケットを羽織ってちょっときれいめに", "scores": { "formality": 15, "structure": 15, "avantgarde": -5 } },
          { "text": "柄シャツやアクセを効かせて個性を出す", "scores": { "decoration": 20, "avantgarde": 10, "playfulness": 10 } }
        ]
      },
      {
        "id": 4,
        "text": "ショップで最初に目が行くのは？",
