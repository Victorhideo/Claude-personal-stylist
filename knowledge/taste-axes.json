          { "text": "見たことないシルエットやデザイン", "scores": { "avantgarde": 20, "decoration": 10, "playfulness": 5 } },
          { "text": "コスパの良い使い回しやすいもの", "scores": { "formality": -5, "decoration": -10, "avantgarde": -10 } }
        ]
      },
      {
        "id": 5,
        "text": "「おしゃれだな」と思う人のイメージは？",
        "options": [
          { "text": "余計なものを削ぎ落としたミニマルな人", "scores": { "decoration": -20, "playfulness": -10, "structure": 5 } },
          { "text": "さりげなくトレンドを取り入れてる人", "scores": { "avantgarde": 10, "playfulness": 5 } },
          { "text": "自分のスタイルを貫いてる個性的な人", "scores": { "avantgarde": 15, "decoration": 5, "playfulness": 5 } },
          { "text": "清潔感があってTPOに合った着こなしの人", "scores": { "formality": 15, "playfulness": -10, "avantgarde": -10 } }
        ]
      },
      {
        "id": 6,
        "text": "アウターを買うなら？",
        "options": [
          { "text": "ステンカラーコートやチェスターコート", "scores": { "formality": 15, "avantgarde": -5, "structure": 15 } },
          { "text": "MA-1やミリタリージャケット", "scores": { "playfulness": 15, "formality": -10, "structure": 5 } },
          { "text": "ノーカラーのミニマルなコート", "scores": { "decoration": -15, "avantgarde": 10, "structure": 10 } },
          { "text": "デザイン性のあるモード系アウター", "scores": { "avantgarde": 20, "decoration": 10, "structure": 5 } }
        ]
      },
      {
        "id": 7,
        "text": "柄物について",
        "options": [
          { "text": "基本着ない。無地が安心", "scores": { "decoration": -20, "playfulness": -10 } },
          { "text": "ストライプやチェックなど定番柄はOK", "scores": { "decoration": 5, "avantgarde": -5, "playfulness": 5 } },
          { "text": "花柄やグラフィック柄も好き", "scores": { "decoration": 15, "playfulness": 15, "avantgarde": 5 } },
          { "text": "総柄やアート的なプリントが好き", "scores": { "decoration": 20, "avantgarde": 15, "playfulness": 15 } }
        ]
      },
      {
        "id": 8,
        "text": "靴はどんなのが多い？",
        "options": [
          { "text": "白スニーカーや黒スニーカー", "scores": { "formality": -5, "playfulness": 5, "decoration": -5 } },
          { "text": "ローファーや革靴", "scores": { "formality": 15, "playfulness": -10, "structure": 10 } },
          { "text": "ハイテクスニーカーやダッドシューズ", "scores": { "playfulness": 15, "avantgarde": 10, "formality": -10 } },
          { "text": "ブーツ（サイドゴア、チャッカなど）", "scores": { "structure": 10, "avantgarde": 5, "formality": 5 } }
        ]
      },
      {
        "id": 9,
        "text": "自分のクローゼットを一言で表すと？",
        "options": [
          { "text": "同じような色・形が並んでる（統一感重視）", "scores": { "decoration": -15, "playfulness": -10, "avantgarde": -5 } },
          { "text": "きれいめとカジュアルが半々", "scores": { "formality": 5, "playfulness": 5 } },
          { "text": "わりとバラバラ。気分で買う", "scores": { "playfulness": 10, "avantgarde": 5, "decoration": 5 } },
          { "text": "こだわりの一軍だけ厳選", "scores": { "avantgarde": 10, "structure": 5, "playfulness": -5 } }
        ]
      },
      {
        "id": 10,
        "text": "ファッションに求めるものは？",
        "options": [
          { "text": "自信を持てること・きちんと見えること", "scores": { "formality": 15, "structure": 10, "playfulness": -10 } },
          { "text": "自分らしさの表現", "scores": { "avantgarde": 15, "decoration": 5, "playfulness": 5 } },
          { "text": "気分が上がること・楽しさ", "scores": { "playfulness": 15, "decoration": 10 } },
          { "text": "日常に溶け込む心地よさ", "scores": { "formality": -10, "structure": -10, "decoration": -10 } }
